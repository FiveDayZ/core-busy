<UserControl x:Class="CoreBusy.App.Controls.CpuCoreTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CoreBusy.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <controls:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>

    <!--  刻意不使用 DropShadowEffect：16 张卡每帧模糊重渲染是卡顿主因，
          高负载强调由红色描边 + 红调底色承担  -->
    <Grid>

        <!--  标准卡片（P-Core）  -->
        <Border x:Name="NormalPanel" Background="{Binding TileBackground}"
                BorderBrush="{Binding TileBorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="9,6,9,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  左侧状态色条：一列扫下来即可判断各核忙闲，取代原先的表情徽章  -->
                <Border Grid.Column="0" Width="3" CornerRadius="1.5" Margin="0,1,8,1"
                        Background="{Binding StatusBrush}" />

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  核心号 + 使用率  -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Id}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource CoreBusyTextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <!--  健康度徽章（v1.17.0）。只放一个数字、不加"健康"二字：
                                  卡片横向空间有限，而颜色分级 + 悬浮说明已足够消歧。
                                  未判定时是纯 "-"，与项目全线"读不到就不猜"的约定一致。  -->
                            <Border Margin="5,0,0,0" Padding="4,1" CornerRadius="4"
                                    Background="{Binding HealthDimBrush}"
                                    VerticalAlignment="Center"
                                    ToolTip="{Binding HealthTipText}" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="{Binding HealthText}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{Binding HealthBrush}" VerticalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding UsageText}" FontSize="18" FontWeight="Bold"
                                   Foreground="{Binding UsageTextBrush}" HorizontalAlignment="Right"
                                   Typography.NumeralAlignment="Tabular" />
                    </Grid>

                    <controls:SegmentBar Grid.Row="1" Height="6" Segments="12" Margin="0,4,0,0"
                                         Visibility="{Binding ShowAggregateBar, Converter={StaticResource BoolToVis}}"
                                         Value="{Binding Usage, Mode=OneWay}"
                                         FillBrush="{Binding UsageBrush}"
                                         EmptyBrush="{StaticResource CoreBusyTrackBrush}" />

                    <!--  核内线程明细：SMT 双线程核逐条展开（T0/T1），单线程核折叠不占位  -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Threads}" Margin="0,4,0,0"
                                  Visibility="{Binding ShowThreads, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,2" ToolTip="{Binding UsageText}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontSize="8" Width="13"
                                               Foreground="{StaticResource CoreBusyTextWeakBrush}"
                                               VerticalAlignment="Center" />
                                    <controls:MiniBar Grid.Column="1" Height="4" VerticalAlignment="Center"
                                                      Value="{Binding Usage, Mode=OneWay}"
                                                      FillBrush="{Binding UsageBrush}"
                                                      TrackBrush="{StaticResource CoreBusyTrackBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  频率 + 状态标签（仅着色文字，不再使用底色药丸）  -->
                    <Grid Grid.Row="2" Margin="0,4,0,0">
                        <TextBlock Text="{Binding FreqText}" FontSize="10.5" HorizontalAlignment="Left"
                                   Foreground="{StaticResource CoreBusyTextWeakBrush}" VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text="{Binding StatusLabel}" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{Binding StatusBrush}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!--  紧凑卡片（E-Core，或分段较多时整体收一档；结构一致，字号与内距各收一档）  -->
        <Border x:Name="CompactPanel" Background="{Binding TileBackground}"
                BorderBrush="{Binding TileBorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="7,5,7,6"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="2.5" CornerRadius="1.25" Margin="0,1,6,1"
                        Background="{Binding StatusBrush}" />

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Id}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource CoreBusyTextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Border Margin="4,0,0,0" Padding="3.5,0.5" CornerRadius="3.5"
                                    Background="{Binding HealthDimBrush}"
                                    VerticalAlignment="Center"
                                    ToolTip="{Binding HealthTipText}" ToolTipService.ShowDuration="20000">
                                <TextBlock Text="{Binding HealthText}" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{Binding HealthBrush}" VerticalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding UsageText}" FontSize="15" FontWeight="Bold"
                                   Foreground="{Binding UsageTextBrush}" HorizontalAlignment="Right"
                                   Typography.NumeralAlignment="Tabular" />
                    </Grid>

                    <controls:SegmentBar Grid.Row="1" Height="5" Segments="12" Margin="0,3,0,0"
                                         Visibility="{Binding ShowAggregateBar, Converter={StaticResource BoolToVis}}"
                                         Value="{Binding Usage, Mode=OneWay}"
                                         FillBrush="{Binding UsageBrush}"
                                         EmptyBrush="{StaticResource CoreBusyTrackBrush}" />

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Threads}" Margin="0,3,0,0"
                                  Visibility="{Binding ShowThreads, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,1.5" ToolTip="{Binding UsageText}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontSize="7.5" Width="12"
                                               Foreground="{StaticResource CoreBusyTextWeakBrush}"
                                               VerticalAlignment="Center" />
                                    <controls:MiniBar Grid.Column="1" Height="3.5" VerticalAlignment="Center"
                                                      Value="{Binding Usage, Mode=OneWay}"
                                                      FillBrush="{Binding UsageBrush}"
                                                      TrackBrush="{StaticResource CoreBusyTrackBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Grid.Row="2" Margin="0,3,0,0">
                        <TextBlock Text="{Binding FreqText}" FontSize="9.5" HorizontalAlignment="Left"
                                   Foreground="{StaticResource CoreBusyTextWeakBrush}" VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text="{Binding StatusLabel}" FontSize="9.5" FontWeight="SemiBold"
                                   Foreground="{Binding StatusBrush}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
