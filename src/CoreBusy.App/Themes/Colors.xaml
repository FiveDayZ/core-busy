<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  CORE-BUSY 基础色板：中性深灰层次（Fluent 2 深色令牌）。
          品牌差异只体现在强调色；BrandTheme.cs 会在主窗口构建前整体覆盖，
          两套色板层级完全对应（背景/面板/卡片/描边/强调/文字/热力图）。  -->

    <!--  层次（明度递增，层次靠明度而非透明度）  -->
    <Color x:Key="CBBgColor">#1A1A1A</Color>
    <Color x:Key="CBPanelColor">#232323</Color>
    <Color x:Key="CBCardColor">#2B2B2B</Color>
    <Color x:Key="CBHoverColor">#333333</Color>

    <!--  描边  -->
    <Color x:Key="CBBorderColor">#3D3D3D</Color>
    <Color x:Key="CBBorderWeakColor">#2E2E2E</Color>

    <!--  强调色（默认 Intel 蓝）+ 语义色  -->
    <Color x:Key="CBAccentColor">#4CA0E0</Color>
    <Color x:Key="CBBlueColor">#6FA8DC</Color>
    <Color x:Key="CBGreenColor">#4EC48F</Color>
    <Color x:Key="CBYellowColor">#E8C044</Color>
    <Color x:Key="CBOrangeColor">#E8934A</Color>
    <Color x:Key="CBDangerColor">#E5484D</Color>

    <!--  文字  -->
    <Color x:Key="CBTextPrimaryColor">#F2F2F2</Color>
    <Color x:Key="CBTextSecondaryColor">#A6A6A6</Color>
    <Color x:Key="CBTextWeakColor">#737373</Color>

    <!--  热力图色带（冷灰 → 橄榄 → 琥珀 → 橙 → 红，语义化，不随品牌变化）
          最低档刻意高于卡片底色亮度，空闲负载下网格依然清晰可辨  -->
    <Color x:Key="CBHeat0Color">#333A42</Color>
    <Color x:Key="CBHeat1Color">#46525E</Color>
    <Color x:Key="CBHeat2Color">#6E6338</Color>
    <Color x:Key="CBHeat3Color">#98801F</Color>
    <Color x:Key="CBHeat4Color">#C08A22</Color>
    <Color x:Key="CBHeat5Color">#DC6A28</Color>
    <Color x:Key="CBHeat6Color">#E5484D</Color>

</ResourceDictionary>
