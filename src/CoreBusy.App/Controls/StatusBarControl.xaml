<UserControl x:Class="CoreBusy.App.Controls.StatusBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        状态栏图标三处：① 品牌标记（芯片）② 运行状态（脉冲，语义色）③ 运行时长（时钟）。
        脉冲图标同时承担「状态点」职责，取代原先恒为绿色的圆点 —— 那个圆点在性能模式下
        不会换色，是失真的（文案说「性能模式」，颜色仍报「正常」）。
    -->
    <Grid Margin="2,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--
            左：品牌标记 + 版本号 + 整机硬件状态（v1.16.0 重排）。
            产品名与 AMD/INTEL EDITION 徽章移除（右上角品牌区块保留），只留版本号，
            腾出宽度显示内存 / 显卡 / 磁盘的「大小 · 占用 · 温度」。
            三项各自独立可见性 —— 来源缺失时整项连同前置分隔线一起折叠，
            不会留下"一根悬空竖线"或"有图标无数据"。详细口径在悬浮提示里。
        -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="15" Height="15" CornerRadius="4"
                    Background="{DynamicResource CoreBusyAccentDimBrush}" VerticalAlignment="Center">
                <Path Data="{StaticResource IconChip}" Stretch="Uniform" Width="10" Height="10"
                      Fill="{DynamicResource CoreBusyAccentBrush}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding VersionText}" FontSize="10.5" Margin="7,0,0,0"
                       Foreground="{DynamicResource CoreBusyTextWeakBrush}" VerticalAlignment="Center"
                       Typography.NumeralAlignment="Tabular" />

            <!--  物理内存：已用/总量 + 占用率（唯一每帧变化的动态项，故用稍亮的次级色）  -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding MemoryVisibility}"
                        ToolTip="{Binding MemoryHintText}" ToolTipService.ShowDuration="20000">
                <Border Width="1" Height="11" Background="{DynamicResource CoreBusyBorderWeakBrush}"
                        Margin="7,0" VerticalAlignment="Center" />
                <Path Data="{StaticResource IconMemory}" Stretch="Uniform" Width="11" Height="11"
                      Stroke="{DynamicResource CoreBusyTextWeakBrush}" StrokeThickness="1.5" Fill="{x:Null}"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      VerticalAlignment="Center" />
                <TextBlock Text="{Binding MemoryText}" FontSize="10.5" Margin="5,0,0,0"
                           Foreground="{DynamicResource CoreBusyTextSecondaryBrush}" VerticalAlignment="Center"
                           Typography.NumeralAlignment="Tabular" />
            </StackPanel>

            <!--  显卡：短型号 + 显存 + 占用 + 温度  -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding GpuVisibility}"
                        ToolTip="{Binding GpuHintText}" ToolTipService.ShowDuration="20000">
                <Border Width="1" Height="11" Background="{DynamicResource CoreBusyBorderWeakBrush}"
                        Margin="7,0" VerticalAlignment="Center" />
                <Path Data="{StaticResource IconGpu}" Stretch="Uniform" Width="11" Height="11"
                      Stroke="{DynamicResource CoreBusyTextWeakBrush}" StrokeThickness="1.5" Fill="{x:Null}"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      VerticalAlignment="Center" />
                <TextBlock Text="{Binding GpuText}" FontSize="10.5" Margin="5,0,0,0"
                           Foreground="{DynamicResource CoreBusyTextWeakBrush}" VerticalAlignment="Center"
                           Typography.NumeralAlignment="Tabular" />
            </StackPanel>

            <!--  磁盘：物理总量 + 已用率 + 温度  -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding DriveVisibility}"
                        ToolTip="{Binding DriveHintText}" ToolTipService.ShowDuration="20000">
                <Border Width="1" Height="11" Background="{DynamicResource CoreBusyBorderWeakBrush}"
                        Margin="7,0" VerticalAlignment="Center" />
                <Path Data="{StaticResource IconDisk}" Stretch="Uniform" Width="11" Height="11"
                      Stroke="{DynamicResource CoreBusyTextWeakBrush}" StrokeThickness="1.5" Fill="{x:Null}"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      VerticalAlignment="Center" />
                <TextBlock Text="{Binding DriveText}" FontSize="10.5" Margin="5,0,0,0"
                           Foreground="{DynamicResource CoreBusyTextWeakBrush}" VerticalAlignment="Center"
                           Typography.NumeralAlignment="Tabular" />
            </StackPanel>
        </StackPanel>

        <!--  右：运行状态药丸 + 运行时长  -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Border CornerRadius="9" Padding="7,2" VerticalAlignment="Center"
                    Background="{Binding StatusDimBrush}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconPulse}" Stretch="Uniform" Width="11" Height="11"
                          Stroke="{Binding StatusBrush}" StrokeThickness="1.8" Fill="{x:Null}"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="5,0,0,0"
                               Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border Width="1" Height="11" Background="{DynamicResource CoreBusyBorderWeakBrush}"
                    Margin="10,0" VerticalAlignment="Center" />

            <Path Data="{StaticResource IconClock}" Stretch="Uniform" Width="11" Height="11"
                  Stroke="{DynamicResource CoreBusyTextWeakBrush}" StrokeThickness="1.6" Fill="{x:Null}"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  VerticalAlignment="Center" />
            <TextBlock Text="运行" FontSize="11" Margin="5,0,0,0"
                       Foreground="{DynamicResource CoreBusyTextWeakBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding UptimeText}" FontSize="11" FontWeight="SemiBold" Margin="5,0,0,0"
                       Foreground="{DynamicResource CoreBusyTextPrimaryBrush}" VerticalAlignment="Center"
                       Typography.NumeralAlignment="Tabular" />

            <!--  运行期累计能耗：数据源依赖硬件传感器，缺失时用弱色表示「已停止更新」  -->
            <Border Width="1" Height="11" Background="{DynamicResource CoreBusyBorderWeakBrush}"
                    Margin="10,0" VerticalAlignment="Center" />

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        ToolTip="{Binding EnergyHintText}" ToolTipService.ShowDuration="20000">
                <Path Data="{StaticResource IconBolt}" Stretch="Uniform" Width="9" Height="11"
                      Fill="{DynamicResource CoreBusyTextWeakBrush}" VerticalAlignment="Center" />
                <TextBlock Text="能耗" FontSize="11" Margin="5,0,0,0"
                           Foreground="{DynamicResource CoreBusyTextWeakBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding EnergyText}" FontSize="11" FontWeight="SemiBold" Margin="5,0,0,0"
                           VerticalAlignment="Center" Typography.NumeralAlignment="Tabular">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource CoreBusyTextPrimaryBrush}" />
                            <Style.Triggers>
                                <!--
                                    无有效功耗读数时不拿伪值冒充：数值转弱色，表示这是
                                    冻结的历史值（或从未取到），而非仍在累积的实时数。
                                -->
                                <DataTrigger Binding="{Binding EnergyIsLive}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource CoreBusyTextWeakBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
