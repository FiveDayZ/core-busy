<UserControl x:Class="CoreBusy.App.Controls.ProcessListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CoreBusy.App.Controls">
    <Border Style="{StaticResource PanelCardStyle}" Padding="10,9">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  标题行  -->
            <Grid Grid.Row="0" Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Width="3" Height="13" RadiusX="1.5" RadiusY="1.5"
                           Fill="{StaticResource CoreBusyAccentBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource SectionTitleText}" Text="主要负载来源" />
                <Border Grid.Column="2" Background="{StaticResource CoreBusyAccentDimBrush}"
                        CornerRadius="4" Padding="5,1" Margin="7,0,0,0" HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                    <TextBlock Text="TOP 5" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource CoreBusyAccentBrush}" />
                </Border>
                <!--  查看全部：v1.10.4 起是真实的可点按钮（此前是静态 TextBlock，点击无效），
                      行为为打开任务管理器查看完整进程列表。  -->
                <Button Grid.Column="3" Style="{StaticResource LinkButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="OnViewAllClick" ToolTip="打开任务管理器查看全部进程">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="查看全部" FontSize="11" VerticalAlignment="Center" />
                        <Path Data="{StaticResource IconChevronRight}" Stretch="Uniform" Width="8" Height="8"
                              Stroke="{StaticResource CoreBusyAccentBrush}" StrokeThickness="2.2" Fill="{x:Null}"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Margin="3,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!--  进程行  -->
            <ItemsControl Grid.Row="1" VerticalAlignment="Top"
                          ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ProcessRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="66" />
                                </Grid.ColumnDefinitions>

                                <!--  进程图标  -->
                                <Border Grid.Column="0" Width="18" Height="18" CornerRadius="5"
                                        Background="{Binding IconDimBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IconText}" FontSize="9" FontWeight="Bold"
                                               Foreground="{Binding IconBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11.5"
                                           Foreground="{StaticResource CoreBusyTextPrimaryBrush}"
                                           VerticalAlignment="Center" Margin="7,0,0,0"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Column="2" Text="{Binding UsageText}" FontSize="11.5"
                                           FontWeight="SemiBold" Foreground="{StaticResource CoreBusyTextSecondaryBrush}"
                                           VerticalAlignment="Center" TextAlignment="Right"
                                           Typography.NumeralAlignment="Tabular" />

                                <controls:MiniBar Grid.Column="3" Height="6" Margin="9,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Value="{Binding BarValue}" Maximum="40"
                                                  FillBrush="{Binding BarBrush}"
                                                  TrackBrush="{StaticResource CoreBusyTrackBrush}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
