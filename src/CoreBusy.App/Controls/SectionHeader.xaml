<UserControl x:Class="CoreBusy.App.Controls.SectionHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Rectangle Grid.Column="0" Width="3" Height="13" RadiusX="1.5" RadiusY="1.5"
                   Fill="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   VerticalAlignment="Center" />

        <TextBlock Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center"
                   Style="{StaticResource SectionTitleText}"
                   Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" />

        <TextBlock Grid.Column="2" Margin="7,0,0,1" VerticalAlignment="Center"
                   Style="{StaticResource SectionSubText}"
                   Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=UserControl}}" />

        <!--  右侧说明：累积视图下由 VM 收起（ModeSwitchVisibility），把位置让给模式开关  -->
        <TextBlock Grid.Column="4" VerticalAlignment="Center"
                   Style="{StaticResource WeakText}"
                   TextTrimming="CharacterEllipsis"
                   Visibility="{Binding RightNoteVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Text="{Binding RightNote, RelativeSource={RelativeSource AncestorType=UserControl}}" />

        <!--  交互槽位：默认空；核心分区用它挂「实时 / 累积」切换与重置  -->
        <ContentPresenter Grid.Column="5" Margin="10,0,0,0" VerticalAlignment="Center"
                          Content="{Binding RightContent, RelativeSource={RelativeSource AncestorType=UserControl}}" />
    </Grid>
</UserControl>
