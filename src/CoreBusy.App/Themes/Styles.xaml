<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  CORE-BUSY 统一样式（卡片/文字/按钮），禁止使用 WPF 默认控件外观。
          字号阶梯收敛为 6 档：14 / 13 / 12 / 11.5 / 11 / 10.5；
          圆角统一为 8（面板）/ 6（卡片与控件）；卡片内距统一为 10。  -->

    <!--  ===== 文字样式 =====  -->
    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource CoreBusyTextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionTitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource CoreBusyTextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="SectionSubText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource CoreBusyTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <Style x:Key="WeakText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource CoreBusyTextWeakBrush}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="MetricLabelText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource CoreBusyTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="MetricValueText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource CoreBusyTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!--  ===== 面板容器 =====  -->
    <Style x:Key="PanelCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CoreBusyCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CoreBusyBorderWeakBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10" />
    </Style>

    <Style x:Key="InnerCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CoreBusyPanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CoreBusyBorderWeakBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!--  窗口控制按钮（最小化/最大化/关闭）  -->
    <Style x:Key="CaptionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource CoreBusyTextSecondaryBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#1AFFFFFF" />
                            <Setter Property="Foreground" Value="{DynamicResource CoreBusyTextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#E81123" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  标题栏图标按钮（性能模式 / 设置 / 日志）—— 仅图标，28x26  -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource CoreBusyTextSecondaryBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource CoreBusyHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource CoreBusyTextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  标题栏文本按钮（保留给需要文字标识的入口）  -->
    <Style x:Key="ToolButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource CoreBusyBorderWeakBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource CoreBusyTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource CoreBusyHoverBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource CoreBusyBorderBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource CoreBusyTextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  排行榜行  -->
    <Style x:Key="RankRowStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="4,4" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CoreBusyPanelBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  进程行  -->
    <Style x:Key="ProcessRowStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="4,5" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CoreBusyPanelBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  ===== 分段切换（实时 / 累积）与配套文字按钮 =====
          两段共用同一底层样式，靠 LoadModeLive / LoadModeCumulative 各自的 DataTrigger
          点亮当前档——不写任何 code-behind 视觉逻辑，选中态完全由 VM 的 IsCumulativeMode 决定。  -->
    <Style x:Key="LoadModeSegmentStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource CoreBusyTextWeakBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Height" Value="20" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource CoreBusyTextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  「实时」段：IsCumulativeMode 为 False 时点亮（样式触发器优先级高于模板触发器）  -->
    <Style x:Key="LoadModeLiveStyle" TargetType="Button" BasedOn="{StaticResource LoadModeSegmentStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCumulativeMode}" Value="False">
                <Setter Property="Background" Value="{DynamicResource CoreBusyAccentDimBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource CoreBusyAccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  「累积」段：IsCumulativeMode 为 True 时点亮  -->
    <Style x:Key="LoadModeCumulativeStyle" TargetType="Button" BasedOn="{StaticResource LoadModeSegmentStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCumulativeMode}" Value="True">
                <Setter Property="Background" Value="{DynamicResource CoreBusyAccentDimBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource CoreBusyAccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  幽灵文字按钮（重置累计）：无框、仅悬停时浮出底色  -->
    <Style x:Key="GhostTextButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource CoreBusyTextWeakBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource CoreBusyHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource CoreBusyTextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ===== 链接式文字按钮（"查看全部"等）：强调色文本 + 悬停底色 =====  -->
    <Style x:Key="LinkButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource CoreBusyAccentBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource CoreBusyHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ===== 告警式链接按钮（v1.16.1）=====
          用于「温度/功耗读不到」这类**需要用户动手才能解决**的提示（提权重启 / 装驱动）：
          与 LinkButtonStyle 同为无框文字按钮，但用琥珀色 —— 强调色（品牌色）表达的是
          "可以点"，琥珀表达的是"这里有事要处理"，两者语义不同，不能混用。  -->
    <Style x:Key="WarnLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource LinkButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource CoreBusyYellowBrush}" />
    </Style>

    <!--  ===== 功耗日历 =====
          格子本身不带颜色，只暴露 Level（0..5）；色带由这里的触发器映射，
          因此换主题/换品牌时不必回头改任何 C# 里的色值。  -->
    <Style x:Key="MonthNavButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource CoreBusyTextWeakBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource CoreBusyHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource CoreBusyTextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  日期格：五档映射到热力图色带（跳过 Heat5，让最高档落到语义上的红色）
          尺寸刻意压到 18px 高：右列三段面板在小窗口下总和会超出可视区，
          日历省下的每一行都是给下方「主要负载来源」腾的空间。  -->
    <Style x:Key="CalendarCellStyle" TargetType="Border">
        <Setter Property="Height" Value="15" />
        <Setter Property="Margin" Value="0.5" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Style.Triggers>
            <!--  Level 0：当月但无记录（≠ 没耗电，只代表没观测到）  -->
            <DataTrigger Binding="{Binding Level}" Value="0">
                <Setter Property="Background" Value="{DynamicResource CoreBusyTrackBrush}" />
            </DataTrigger>
            <!--
                Level 0 但当天确有读数 → 不定档（观测不足，或本月参照日数不足）。
                必须排在 Level=0 之后：XAML 触发器后置者胜，否则会落回 Track 灰、
                被读成「无记录」，那就又回到"把没看够当成没用电"的老问题上。
            -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding HasRecord}" Value="True" />
                    <Condition Binding="{Binding IsRanked}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource CoreBusyCalendarPendingBrush}" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="1">
                <Setter Property="Background" Value="{DynamicResource CoreBusyHeat1Brush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="2">
                <Setter Property="Background" Value="{DynamicResource CoreBusyHeat2Brush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="3">
                <Setter Property="Background" Value="{DynamicResource CoreBusyHeat3Brush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="4">
                <Setter Property="Background" Value="{DynamicResource CoreBusyHeat4Brush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="5">
                <Setter Property="Background" Value="{DynamicResource CoreBusyHeat6Brush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsToday}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource CoreBusyAccentBrush}" />
            </DataTrigger>
            <!--  邻月占位格放在最后：它的赋值要盖过上面的档位色（排序靠后者胜）  -->
            <DataTrigger Binding="{Binding IsInMonth}" Value="False">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Opacity" Value="0.35" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
