<Window x:Class="CoreBusy.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CoreBusy.App.Controls"
        Title="CORE-BUSY 核忙 - CPU Core Activity Monitor"
        Icon="pack://application:,,,/Assets/CoreBusy.ico"
        Width="900" Height="640"
        MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource CoreBusyBackgroundBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!--  ==================== 0. 标题栏（同时承担 CPU 身份条）  ====================  -->
        <Grid Grid.Row="0" Background="{StaticResource CoreBusyPanelBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="12,0,0,0">
                <Grid Width="22" Height="22" VerticalAlignment="Center">
                    <Border CornerRadius="5" Background="{StaticResource CoreBusyAccentDimBrush}" />
                    <Path Data="{StaticResource IconChip}" Fill="{StaticResource CoreBusyAccentBrush}"
                          Stretch="Uniform" Width="13" Height="13"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="CORE-BUSY" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource CoreBusyTextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
                <Border Width="1" Height="12" Background="{StaticResource CoreBusyBorderWeakBrush}"
                        Margin="10,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CpuName}" FontSize="12"
                           Foreground="{StaticResource CoreBusyTextSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding CpuSpecs}" FontSize="11" Margin="8,0,0,0"
                           Foreground="{StaticResource CoreBusyTextWeakBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="PerfModeButton" Click="OnTogglePerformanceMode"
                        ToolTip="性能模式：以低开销档运行（采样降至 2s、暂停硬件传感器），减少对前台程序的干扰">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPerformanceMode}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource CoreBusyAccentDimBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource CoreBusyAccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Data="{StaticResource IconGamepad}" Stretch="Uniform" Width="13" Height="13"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" Fill="{x:Null}"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          VerticalAlignment="Center" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="OnOpenSettings"
                        ToolTip="设置：采样周期 / 硬件传感器 / 主题 / 性能优化">
                    <Path Data="{StaticResource IconGear}" Stretch="Uniform" Width="13" Height="13"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          VerticalAlignment="Center" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Margin="0,0,10,0" Click="OnOpenLogFolder"
                        ToolTip="打开运行日志文件夹">
                    <Path Data="{StaticResource IconMore}" Stretch="Uniform" Width="13" Height="13"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          VerticalAlignment="Center" />
                </Button>

                <Button Style="{StaticResource CaptionButtonStyle}" Click="OnMinimize">
                    <Path Data="{StaticResource IconMin}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.3" Stretch="Uniform" Width="10" Height="10" />
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Click="OnMaximize">
                    <Path Data="{StaticResource IconMax}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.3" Stretch="Uniform" Width="9" Height="9" />
                </Button>
                <Button Style="{StaticResource CloseButtonStyle}" Click="OnClose">
                    <Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.3" Stretch="Uniform" Width="10" Height="10" />
                </Button>
            </StackPanel>
        </Grid>

        <!--  ==================== 1. 主内容区：左（核心 + 热力图）/ 右（概览 + 负载来源）  ====================  -->
        <Grid Grid.Row="1" Margin="10,10,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!--  左列  -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <!--
                        核心分区按内容取自然高度，封顶 260px。核心数多时（8P+16E 或 3 段以上）
                        若仍让 Auto 行无限增高，会挤占下方 * 行把热力图压到 MinHeight 以下遭裁切。
                    -->
                    <RowDefinition Height="Auto" MaxHeight="260" />
                    <RowDefinition Height="*" MinHeight="150" />
                </Grid.RowDefinitions>

                <!--  1.1 核心分区（动态生成：Intel 混合 → P/E；AMD → CPU Core / CCD n）  -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding CoreGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PanelCardStyle}" Padding="10,8,10,9" Margin="0,0,0,8">
                                    <StackPanel>
                                        <controls:SectionHeader Title="{Binding Title}"
                                                                Subtitle="{Binding Subtitle}"
                                                                RightNote="{Binding RightNote}"
                                                                RightNoteVisibility="{Binding RightNoteVisibility}"
                                                                AccentBrush="{StaticResource CoreBusyAccentBrush}">
                                            <controls:SectionHeader.RightContent>
                                                <!--
                                                    负载口径开关（实时 / 累积）。状态是全局唯一的，
                                                    因此只在第一段分区挂出控件（ModeSwitchVisibility 在 VM 内决定），
                                                    Intel 这种 P/E 两段的平台不会出现两个功能重复的开关。
                                                -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding ModeSwitchVisibility}">
                                                    <Border Background="{StaticResource CoreBusyTrackBrush}"
                                                            CornerRadius="5" Padding="1.5">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="实时" Tag="live"
                                                                    Style="{StaticResource LoadModeLiveStyle}"
                                                                    ToolTip="实时负载：每颗核心的瞬时使用率"
                                                                    Click="OnCoreLoadModeClick" />
                                                            <Button Content="累积" Tag="cumulative"
                                                                    Style="{StaticResource LoadModeCumulativeStyle}"
                                                                    ToolTip="累积负载：本次运行时间内的时间加权均值，并按高低排名"
                                                                    Click="OnCoreLoadModeClick" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Button Content="重置" Margin="6,0,0,0"
                                                            Visibility="{Binding ResetVisibility}"
                                                            Style="{StaticResource GhostTextButtonStyle}"
                                                            ToolTip="清零累积统计，从当前时刻重新开始积分"
                                                            Click="OnResetCumulativeClick" />
                                                </StackPanel>
                                            </controls:SectionHeader.RightContent>
                                        </controls:SectionHeader>
                                        <ItemsControl ItemsSource="{Binding Cores}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="{Binding TileColumns}" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <controls:CpuCoreTile Margin="3,2" IsCompact="{Binding IsCompact}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!--  1.2 60 秒负载热力图  -->
                <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}" Padding="10,8,10,7"
                        MinHeight="150">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <controls:SectionHeader Title="60 秒负载热力图"
                                                    Subtitle="每行一条线程，颜色越亮负载越高"
                                                    AccentBrush="{StaticResource CoreBusyAccentBrush}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="低" FontSize="10.5" VerticalAlignment="Center"
                                           Foreground="{StaticResource CoreBusyTextWeakBrush}" />
                                <Border Width="12" Height="8" CornerRadius="2" Margin="5,0,0,0"
                                        Background="{StaticResource CoreBusyHeat0Brush}" />
                                <Border Width="12" Height="8" CornerRadius="2" Margin="2,0,0,0"
                                        Background="{StaticResource CoreBusyHeat1Brush}" />
                                <Border Width="12" Height="8" CornerRadius="2" Margin="2,0,0,0"
                                        Background="{StaticResource CoreBusyHeat2Brush}" />
                                <Border Width="12" Height="8" CornerRadius="2" Margin="2,0,0,0"
                                        Background="{StaticResource CoreBusyHeat3Brush}" />
                                <Border Width="12" Height="8" CornerRadius="2" Margin="2,0,0,0"
                                        Background="{StaticResource CoreBusyHeat4Brush}" />
                                <Border Width="12" Height="8" CornerRadius="2" Margin="2,0,0,0"
                                        Background="{StaticResource CoreBusyHeat5Brush}" />
                                <Border Width="12" Height="8" CornerRadius="2" Margin="2,0,0,0"
                                        Background="{StaticResource CoreBusyHeat6Brush}" />
                                <TextBlock Text="高" FontSize="10.5" VerticalAlignment="Center" Margin="5,0,0,0"
                                           Foreground="{StaticResource CoreBusyTextWeakBrush}" />
                            </StackPanel>
                        </Grid>

                        <controls:HeatMapControl Grid.Row="1" Margin="0,2,0,4"
                                                 RowsData="{Binding Heatmap}"
                                                 RowLabels="{Binding HeatmapLabels}"
                                                 LabelWidth="0" />

                        <!--  时间轴：左侧留白 = 热力图行标签宽度（LabelWidth 自动模式下约 30）  -->
                        <Grid Grid.Row="2" Margin="30,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="60s" Style="{StaticResource WeakText}" HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Text="45s" Style="{StaticResource WeakText}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="30s" Style="{StaticResource WeakText}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="15s" Style="{StaticResource WeakText}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="现在" Style="{StaticResource WeakText}" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!--
                右列：指标唯一来源（顶部不再重复展示同一组数值）。
                整列包一层 ScrollViewer：三段面板合计高度在小窗口下会超出可视区，
                没有它就只能被裁切——用户把窗口拉矮时宁可多一根滚动条，也不要丢掉一段面板。

                v1.17.1 实测（用 UIA 读 ScrollBar 的 RangeValue.Maximum，即「内容高 − 视口高」，
                不是目测像素）：
                  窗口高 620（旧默认）→ 溢出 21.0px；
                  窗口高 620 且删掉日历口径声明行 → 溢出 4.5px（该行值 16.5px）；
                  窗口高 640 → 溢出 0，默认尺寸下不再出现滚动条。
                也就是说：默认高度是按「内容自然高 + 约 15px 余量」定的，620 差了 4.5px。
                **改这三个面板的行高/字号/内边距后，务必用 .workbuddy/measure_scroll.py 复测**
                —— 这类量靠截图目测的误差（十几像素）比要判的量本身还大。
            -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <StackPanel>
                    <controls:CpuOverviewPanel />

                    <controls:PowerCalendarPanel Margin="0,8,0,0" />

                    <!--  进程面板按内容取高：榜单恒为 5 行，若用 * 撑满会在底部留出大片空卡片  -->
                    <controls:ProcessListPanel Margin="0,8,0,0"
                                               ItemsSource="{Binding Processes}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!--  ==================== 2. 底部状态栏  ====================  -->
        <Border Grid.Row="2" Background="{StaticResource CoreBusyPanelBrush}"
                BorderBrush="{StaticResource CoreBusyBorderWeakBrush}" BorderThickness="0,1,0,0"
                Padding="12,0">
            <controls:StatusBarControl />
        </Border>
    </Grid>
</Window>
