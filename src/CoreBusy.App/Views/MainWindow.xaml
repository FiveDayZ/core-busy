<Window x:Class="CoreBusy.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CoreBusy.App.Controls"
        Title="CORE-BUSY 核忙 - CPU Core Activity Monitor"
        Icon="pack://application:,,,/Assets/CoreBusy.ico"
        Width="720" Height="500"
        MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource CoreBusyBackgroundBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <!--
      迷你行模板引用了 InverseBoolToVisibility，而它此前只在 CpuCoreTile.xaml 的
      局部资源里定义 —— StaticResource 在模板实例化时才解析，找不到就抛异常。
      异常发生在容器生成的事务里，把本批全部视觉更新（含 7 张卡的移除）一起炸掉，
      又被全局 DispatcherUnhandledException 吞掉 —— 表现为「焦点态零生效、零报错」。
      这是焦点展开悬案的最终根因（UIA 树里迷你行 DataItemControl 的 Name 退化为
      VM 类型全名，即 AutomationProperties.Name 绑定随模板一起未实例化的铁证）。
    -->
    <Window.Resources>
        <controls:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <BooleanToVisibilityConverter x:Key="CoreBusyBoolToVis" />
    </Window.Resources>


    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="22" />
        </Grid.RowDefinitions>

        <!--  ==================== 0. 标题栏（同时承担 CPU 身份条）  ====================  -->
        <Grid Grid.Row="0" Background="{StaticResource CoreBusyPanelBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" VerticalAlignment="Center"
                        Margin="12,0,0,0">
                <!--  v1.26.4：品牌角标 = 新图标的「Die 2×2 负载格」矢量版。
                      颜色走 DynamicResource 品牌画刷 —— 随 intel/amd 主题联动；
                      四格透明度阶梯 = 负载分档语义（与核卡色阶同构）。  -->
                <Grid DockPanel.Dock="Left" Width="22" Height="22" VerticalAlignment="Center">
                    <Border CornerRadius="5" Background="{DynamicResource CoreBusyAccentDimBrush}" />
                    <UniformGrid Columns="2" Rows="2" Margin="4.5">
                        <Border CornerRadius="1.5" Margin="1" Background="{DynamicResource CoreBusyAccentBrush}" Opacity="0.35" />
                        <Border CornerRadius="1.5" Margin="1" Background="{DynamicResource CoreBusyAccentBrush}" Opacity="0.55" />
                        <Border CornerRadius="1.5" Margin="1" Background="{DynamicResource CoreBusyAccentBrush}" Opacity="0.75" />
                        <Border CornerRadius="1.5" Margin="1" Background="{DynamicResource CoreBusyAccentBrush}" />
                    </UniformGrid>
                </Grid>
                <TextBlock DockPanel.Dock="Left" Text="CORE-BUSY" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource CoreBusyTextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
                <Border DockPanel.Dock="Left" Width="1" Height="12" Background="{StaticResource CoreBusyBorderWeakBrush}"
                        Margin="10,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CpuName}" ToolTip="{Binding CpuSpecs}" FontSize="12"
                           Foreground="{StaticResource CoreBusyTextSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="PerfModeButton" Click="OnTogglePerformanceMode"
                        ToolTip="性能模式：以低开销档运行（采样降至 2s、暂停硬件传感器），减少对前台程序的干扰">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPerformanceMode}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource CoreBusyAccentDimBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource CoreBusyAccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Data="{StaticResource IconGamepad}" Stretch="Uniform" Width="13" Height="13"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" Fill="{x:Null}"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          VerticalAlignment="Center" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="OnOpenSettings"
                        ToolTip="设置：采样周期 / 硬件传感器 / 主题 / 性能优化">
                    <Path Data="{StaticResource IconGear}" Stretch="Uniform" Width="13" Height="13"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          VerticalAlignment="Center" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Margin="0,0,10,0" Click="OnOpenDataFolder"
                        ToolTip="打开数据文件夹（配置与历史记录）">
                    <Path Data="{StaticResource IconMore}" Stretch="Uniform" Width="13" Height="13"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          VerticalAlignment="Center" />
                </Button>

                <Button Style="{StaticResource CaptionButtonStyle}" Click="OnMinimize">
                    <Path Data="{StaticResource IconMin}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.3" Stretch="Uniform" Width="10" Height="10" />
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Click="OnMaximize">
                    <Path Data="{StaticResource IconMax}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.3" Stretch="Uniform" Width="9" Height="9" />
                </Button>
                <Button Style="{StaticResource CloseButtonStyle}" Click="OnClose">
                    <Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.3" Stretch="Uniform" Width="10" Height="10" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 静态主板作为空间底座；走线留在分区外，内容使用不透明插座面板。 -->
        <controls:PcbBoardControl Grid.Row="1" Margin="8,6" />
        <Grid Grid.Row="1" Margin="20,7,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,5">
                <StackPanel>
                    <TextBlock Text="核心主板" ToolTip="{Binding SnapshotStatusText}" FontSize="13" Margin="12,0,0,0" FontWeight="SemiBold"
                               Foreground="{StaticResource CoreBusyTextPrimaryBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding BoardHintText}" ToolTip="{Binding SnapshotStatusText}" TextTrimming="CharacterEllipsis" MaxWidth="400" FontSize="11" HorizontalAlignment="Right"
                           VerticalAlignment="Bottom" Margin="12,0,16,2"
                           Foreground="{StaticResource CoreBusyTextSecondaryBrush}" />
            </Grid>
            <Grid Grid.Row="1">
                <ScrollViewer Style="{StaticResource CompactScrollViewer}" x:Name="CoreScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding CoreGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" Padding="4" Margin="0,0,0,4"
                                        BorderBrush="{StaticResource CoreBusyBorderBrush}" BorderThickness="1" CornerRadius="9">
                                    <StackPanel>
                                        <controls:SectionHeader Title="{Binding Title}"
                                                                Subtitle="{Binding Subtitle}"
                                                                RightNote="{Binding RightNote}"
                                                                RightNoteVisibility="{Binding RightNoteVisibility}"
                                                                AccentBrush="{StaticResource CoreBusyAccentBrush}" Margin="2,0,2,2">
                                            <controls:SectionHeader.RightContent>
                                                <!--
                                                    负载口径开关（实时 / 累积）。状态是全局唯一的，
                                                    因此只在第一段分区挂出控件（ModeSwitchVisibility 在 VM 内决定），
                                                    Intel 这种 P/E 两段的平台不会出现两个功能重复的开关。
                                                -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding ModeSwitchVisibility}">
                                                    <Border Background="{StaticResource CoreBusyTrackBrush}"
                                                            CornerRadius="5" Padding="1.5">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="实时" Tag="live"
                                                                    Style="{StaticResource LoadModeLiveStyle}"
                                                                    ToolTip="实时负载：每颗核心的瞬时使用率"
                                                                    Click="OnCoreLoadModeClick" />
                                                            <Button Content="累积" Tag="cumulative"
                                                                    Style="{StaticResource LoadModeCumulativeStyle}"
                                                                    ToolTip="累积负载：本次运行时间内的时间加权均值，并按高低排名"
                                                                    Click="OnCoreLoadModeClick" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Button Content="重置" Margin="6,0,0,0"
                                                            Visibility="{Binding ResetVisibility}"
                                                            Style="{StaticResource GhostTextButtonStyle}"
                                                            ToolTip="清零累积统计，从当前时刻重新开始积分"
                                                            Click="OnResetCumulativeClick" />
                                                </StackPanel>
                                            </controls:SectionHeader.RightContent>
                                        </controls:SectionHeader>


                                        <ItemsControl ItemsSource="{Binding Cores}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <controls:CoreTilePanel MaxColumns="{Binding TileColumns}"
                                                                            FitEightCores="{Binding IsSingleScreenBoard, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!--  点击弹出的卡片承载该核全部深度信息
                                                          （实时指标/峰值/等级/EXP）——
                                                          主界面保留 CPU、等级和负载，深度信息进入详情。
                                                          MaxWidth + 列内拉伸：UniformGrid 单元
                                                          宽 = 分区宽 / 列数，宽窗/最大化时少核段会被
                                                          单元拉伸；此处封顶卡片宽度（窄窗仍可自由收缩）。  -->
                                                    <Border Background="Transparent" Cursor="Hand"
                                                            MaxWidth="184" HorizontalAlignment="Stretch"
                                                            Tag="{Binding Id}"
                                                            MouseLeftButtonUp="OnCoreTileClick"
                                                            AutomationProperties.Name="{Binding Id}"
                                                            Focusable="True">
                                                        <controls:CpuCoreTile Margin="6,4"
                                                                               IsCompact="{Binding IsCompact}"
                                                                               IsCondensed="{Binding IsCondensedBoard, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!--  ==================== 2. 底部状态栏  ====================  -->
        <Border Grid.Row="2" Background="{StaticResource CoreBusyPanelBrush}"
                BorderBrush="{StaticResource CoreBusyBorderWeakBrush}" BorderThickness="0,1,0,0"
                Padding="12,0">
            <controls:StatusBarControl />
        </Border>
    
    <!-- 核心详情在窗口内居中，信息优先；不再承载戳击、台词与装饰性互动。 -->
    <Popup x:Name="FocusCard" AllowsTransparency="True" StaysOpen="False" Placement="Center"
           PopupAnimation="Fade">
        <Border x:Name="FocusCardRoot" Width="288" Margin="6"
                Background="{StaticResource CoreBusyPanelBrush}"
                BorderBrush="{StaticResource CoreBusyBorderBrush}" BorderThickness="1" CornerRadius="9">
            <Border.MaxHeight>
                <Binding Path="Height" Source="{x:Static SystemParameters.WorkArea}" />
            </Border.MaxHeight>
            <Border.Resources>
                <Style x:Key="DetailLabel" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="10" />
                    <Setter Property="Foreground" Value="{StaticResource CoreBusyTextWeakBrush}" />
                </Style>
                <Style x:Key="DetailValue" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Margin" Value="0,3,0,0" />
                    <Setter Property="Foreground" Value="{StaticResource CoreBusyTextPrimaryBrush}" />
                </Style>
            </Border.Resources>
            <ScrollViewer Style="{StaticResource CompactScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="10" Focusable="False">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Level.LevelText}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource CoreBusyAccentBrush}" HorizontalAlignment="Right" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Id}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource CoreBusyTextPrimaryBrush}" />
                            <TextBlock Text="核心详情" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource CoreBusyTextSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding TopologyText}" Style="{StaticResource DetailLabel}" Margin="0,3,0,0" />
                    <Grid Margin="0,7,0,7" ToolTip="{Binding Level.AppearanceText}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:CoreEvolutionVisual x:Name="CurrentCorePortrait" Width="76" Height="76"
                                                      Vendor="{Binding Level.Vendor}" Stage="{Binding Level.StageIndex}"
                                                      EvolutionVersion="{Binding Level.EvolutionVersion}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="{Binding Level.BrandText}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource CoreBusyTextPrimaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Role.Label}" FontSize="10" Margin="0,5,0,0"
                                       Foreground="{Binding Role.AccentBrush}" ToolTip="{Binding Role.TipText}" />
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="实时负载" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding LiveUsageText}" Style="{StaticResource DetailValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" ToolTip="{Binding FrequencySourceText}">
                            <TextBlock Text="当前频率" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding LiveFrequencyText}" Style="{StaticResource DetailValue}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,7,0,0" ToolTip="按采样期间驻留时间加权的频率；不等同于瞬时时钟">
                            <TextBlock Text="有效频率" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding EffectiveFrequencyText}" Style="{StaticResource DetailValue}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,7,0,0" ToolTip="核心请求电压 VID；不等于主板供电端实测电压，缺测显示 -">
                            <TextBlock Text="核心 VID" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding VoltageText}" Style="{StaticResource DetailValue}" />
                        </StackPanel>
                    </Grid>
                    <controls:MiniBar Height="3" Margin="0,9,0,0" Value="{Binding LiveUsage, Mode=OneWay}"
                                      FillBrush="{StaticResource CoreBusyAccentBrush}" TrackBrush="{StaticResource CoreBusyTrackBrush}" />
                    <DockPanel Margin="0,7,0,0" ToolTip="历史峰值取有效频率；时长为进入历史峰值 99% 档的累计观测时长">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PeakDurationText}" Style="{StaticResource DetailLabel}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding PeakFreqText}" Style="{StaticResource DetailLabel}" />
                    </DockPanel>
                    <Border BorderBrush="{StaticResource CoreBusyBorderWeakBrush}" BorderThickness="0,1,0,0"
                            Padding="0,8,0,0" Margin="0,9,0,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Level.EtaText}" FontSize="10" HorizontalAlignment="Right"
                                           Foreground="{StaticResource CoreBusyAccentBrush}" />
                                <TextBlock Text="升级进度" FontSize="11" Foreground="{StaticResource CoreBusyTextSecondaryBrush}" />
                            </DockPanel>
                            <Border x:Name="ExpTrack" Height="5" Margin="0,7,0,0" CornerRadius="2.5"
                                    Background="{StaticResource CoreBusyTrackBrush}" ToolTip="{Binding Level.TipText}" ToolTipService.ShowDuration="20000">
                                <Border x:Name="ExpFill" HorizontalAlignment="Left" Width="0" CornerRadius="2.5"
                                        Background="{StaticResource CoreBusyAccentBrush}" />
                            </Border>
                            <TextBlock Text="{Binding Level.ProgressSummaryText}" Style="{StaticResource DetailLabel}"
                                       Margin="0,6,0,0" TextWrapping="Wrap" />
                            <Grid Margin="0,7,0,0" ToolTip="{Binding Level.NextEvolutionTip}"
                                  Visibility="{Binding Level.HasNextEvolution, Converter={StaticResource CoreBusyBoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:CoreEvolutionVisual Width="32" Height="32" IsSilhouette="True"
                                                              Vendor="{Binding Level.Vendor}" Stage="{Binding Level.NextStageIndex}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Level.NextEvolutionText}" FontSize="10.5"
                                               Foreground="{StaticResource CoreBusyTextSecondaryBrush}" TextWrapping="Wrap" />
                                    <controls:MiniBar x:Name="EvolutionTrack" Height="3" Margin="0,5,0,0" Maximum="1"
                                                      Value="{Binding Level.EvolutionProgress, Mode=OneWay}"
                                                      FillBrush="{StaticResource CoreBusyAccentBrush}" TrackBrush="{StaticResource CoreBusyTrackBrush}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Popup>
</Grid>
</Window>
