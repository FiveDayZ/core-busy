<UserControl x:Class="CoreBusy.App.Controls.CpuOverviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CoreBusy.App.Controls">
    <Border Style="{StaticResource PanelCardStyle}" Padding="10,9">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  标题行  -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Width="3" Height="13" RadiusX="1.5" RadiusY="1.5"
                           Fill="{StaticResource CoreBusyAccentBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource SectionTitleText}" Text="CPU 概览" />
                <!--  内核驱动提示（v1.16.1）：温度/功耗读不到时说明原因并给出一键提权重启。
                      放在标题行而不是指标行下方，是因为整列卡片高度是内容撑开的
                      （MainWindow 右列 ScrollViewer），多一行会把日历/进程面板往下推。  -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!--  逐核确定性自检入口（v1.18.0，方案 P3）：唯一能"确定性"判定某颗核是否
                          算错的手段（已知正确结果比对，非统计推断）。刻意做成**用户显式触发**
                          而非自动运行 —— 它会真的把每颗核依次拉到满载数秒。
                          放在标题行右侧与「需提权」提示同区：二者语义都是"用户可动手做的事"。  -->
                    <Button Style="{StaticResource LinkButtonStyle}"
                            Content="{Binding SelfTestText}"
                            Click="OnSelfTestClick"
                            ToolTip="{Binding SelfTestTipText}"
                            ToolTipService.ShowDuration="20000"
                            Margin="0,0,6,0" />
                    <Button Style="{StaticResource WarnLinkButtonStyle}"
                            Visibility="{Binding SensorWarningVisibility}"
                            Click="OnElevateClick"
                            ToolTip="{Binding SensorWarningDetail}"
                            Margin="0,0,6,0">
                        <TextBlock Text="{Binding SensorWarningBadge}" FontSize="11"
                                   VerticalAlignment="Center" />
                    </Button>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource WeakText}"
                               Text="{Binding OverviewClockText}" Typography.NumeralAlignment="Tabular" />
                </StackPanel>
            </Grid>

            <!--  环形使用率 + 四条指标  -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="92" Height="92" VerticalAlignment="Center" Margin="0,0,10,0">
                    <controls:DonutGauge Value="{Binding TotalUsage, Mode=OneWay}"
                                         TrackBrush="{StaticResource CoreBusyTrackBrush}"
                                         ValueBrush="{StaticResource CoreBusyAccentBrush}" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalUsageText}" FontSize="19" FontWeight="Bold"
                                   Foreground="{StaticResource CoreBusyTextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular" />
                        <TextBlock Text="使用率" FontSize="10"
                                   Foreground="{StaticResource CoreBusyTextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <!--  当前温度  -->
                    <Grid Height="22" Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="5"
                                Background="{StaticResource CoreBusyDangerDimBrush}" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconFlame}" Stretch="Uniform" Width="9" Height="9"
                                  Fill="{StaticResource CoreBusyDangerBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="温度" Style="{StaticResource MetricLabelText}" Margin="7,0,0,0" />
                        <TextBlock Grid.Column="2" Text="{Binding OverviewTempText}" Style="{StaticResource MetricValueText}" />
                    </Grid>

                    <!--  CPU 功耗  -->
                    <Grid Height="22" Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="5"
                                Background="{StaticResource CoreBusyYellowDimBrush}" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconBolt}" Stretch="Uniform" Width="9" Height="9"
                                  Fill="{StaticResource CoreBusyYellowBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="功耗" Style="{StaticResource MetricLabelText}" Margin="7,0,0,0" />
                        <TextBlock Grid.Column="2" Text="{Binding OverviewPowerText}" Style="{StaticResource MetricValueText}" />
                    </Grid>

                    <!--  平均频率  -->
                    <Grid Height="22" Margin="0,0,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="5"
                                Background="{StaticResource CoreBusyAccentDimBrush}" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconWave}" Stretch="Uniform" Width="9" Height="9"
                                  Stroke="{StaticResource CoreBusyAccentBrush}" StrokeThickness="2" Fill="{x:Null}"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="频率" Style="{StaticResource MetricLabelText}" Margin="7,0,0,0" />
                        <TextBlock Grid.Column="2" Text="{Binding OverviewFreqText}" Style="{StaticResource MetricValueText}" />
                    </Grid>

                    <!--  风扇转速：LHM 读不到时由 ASUS WMI 补（v1.16.3），悬停看来源/原因  -->
                    <Grid Height="22" Margin="0,0,0,3" ToolTip="{Binding FanHintText}" ToolTipService.ShowDuration="20000">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="5"
                                Background="{StaticResource CoreBusyBlueDimBrush}" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconFan}" Stretch="Uniform" Width="9" Height="9"
                                  Stroke="{StaticResource CoreBusyBlueBrush}" StrokeThickness="2" Fill="{x:Null}"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="风扇" Style="{StaticResource MetricLabelText}" Margin="7,0,0,0" />
                        <TextBlock Grid.Column="2" Text="{Binding OverviewFanText}" Style="{StaticResource MetricValueText}" />
                    </Grid>

                    <!--  核心健康度（v1.17.0）：均分 / 最低核。
                          刻意排在这些**读数**之下：上面四行是传感器直接给的量，这一行是推导值，
                          先后顺序本身就在提示"先看事实、再看推断"。悬停给逐核明细与完整口径。  -->
                    <Grid Height="22" ToolTip="{Binding HealthHintText}" ToolTipService.ShowDuration="20000">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="5"
                                Background="{StaticResource CoreBusyGreenDimBrush}" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconGauge}" Stretch="Uniform" Width="9" Height="9"
                                  Stroke="{StaticResource CoreBusyGreenBrush}" StrokeThickness="2" Fill="{x:Null}"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="健康" Style="{StaticResource MetricLabelText}" Margin="7,0,0,0" />
                        <TextBlock Grid.Column="2" Text="{Binding OverviewHealthText}" Style="{StaticResource MetricValueText}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
