<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  CORE-BUSY 全局画刷（颜色统一从 Colors.xaml 引用，禁止散落硬编码）。
          BrandTheme 会在运行时由按品牌覆盖同名资源；三品牌共用中性层次基底，仅强调色不同。  -->

    <SolidColorBrush x:Key="CoreBusyBackgroundBrush" Color="{StaticResource CBBgColor}" />
    <SolidColorBrush x:Key="CoreBusyPanelBrush" Color="{StaticResource CBPanelColor}" />
    <SolidColorBrush x:Key="CoreBusyCardBrush" Color="{StaticResource CBCardColor}" />
    <SolidColorBrush x:Key="CoreBusyHoverBrush" Color="{StaticResource CBHoverColor}" />

    <SolidColorBrush x:Key="CoreBusyBorderBrush" Color="{StaticResource CBBorderColor}" />
    <SolidColorBrush x:Key="CoreBusyBorderWeakBrush" Color="{StaticResource CBBorderWeakColor}" />

    <SolidColorBrush x:Key="CoreBusyAccentBrush" Color="{StaticResource CBAccentColor}" />
    <SolidColorBrush x:Key="CoreBusyBlueBrush" Color="{StaticResource CBBlueColor}" />
    <SolidColorBrush x:Key="CoreBusyGreenBrush" Color="{StaticResource CBGreenColor}" />
    <SolidColorBrush x:Key="CoreBusyYellowBrush" Color="{StaticResource CBYellowColor}" />
    <SolidColorBrush x:Key="CoreBusyOrangeBrush" Color="{StaticResource CBOrangeColor}" />
    <SolidColorBrush x:Key="CoreBusyDangerBrush" Color="{StaticResource CBDangerColor}" />

    <SolidColorBrush x:Key="CoreBusyTextPrimaryBrush" Color="{StaticResource CBTextPrimaryColor}" />
    <SolidColorBrush x:Key="CoreBusyTextSecondaryBrush" Color="{StaticResource CBTextSecondaryColor}" />
    <SolidColorBrush x:Key="CoreBusyTextWeakBrush" Color="{StaticResource CBTextWeakColor}" />

    <SolidColorBrush x:Key="CoreBusyTrackBrush" Color="#3A3A3A" />

    <!--  半透明变体（状态徽章背景 / 图标底座）  -->
    <SolidColorBrush x:Key="CoreBusyAccentDimBrush" Color="#334CA0E0" />
    <SolidColorBrush x:Key="CoreBusyBlueDimBrush" Color="#266FA8DC" />
    <SolidColorBrush x:Key="CoreBusyGreenDimBrush" Color="#264EC48F" />
    <SolidColorBrush x:Key="CoreBusyYellowDimBrush" Color="#26E8C044" />
    <SolidColorBrush x:Key="CoreBusyOrangeDimBrush" Color="#26E8934A" />
    <SolidColorBrush x:Key="CoreBusyDangerDimBrush" Color="#33E5484D" />
    <SolidColorBrush x:Key="CoreBusyTileDangerBrush" Color="#33262A" />

    <!--  热力图色带画刷  -->
    <SolidColorBrush x:Key="CoreBusyHeat0Brush" Color="{StaticResource CBHeat0Color}" />
    <SolidColorBrush x:Key="CoreBusyHeat1Brush" Color="{StaticResource CBHeat1Color}" />
    <SolidColorBrush x:Key="CoreBusyHeat2Brush" Color="{StaticResource CBHeat2Color}" />
    <SolidColorBrush x:Key="CoreBusyHeat3Brush" Color="{StaticResource CBHeat3Color}" />
    <SolidColorBrush x:Key="CoreBusyHeat4Brush" Color="{StaticResource CBHeat4Color}" />
    <SolidColorBrush x:Key="CoreBusyHeat5Brush" Color="{StaticResource CBHeat5Color}" />
    <SolidColorBrush x:Key="CoreBusyHeat6Brush" Color="{StaticResource CBHeat6Color}" />

    <!--
        能耗日历专用：当天有读数、但不足以给出多/少结论（观测不足 1 小时，或本月达标日数不足）。
        刻意用色带之外的**低饱和紫灰** —— 既不能与 Track（#3A3A3A，纯灰＝「无记录」）混同，
        也不能落进 Heat0..6 的冷灰→橄榄→琥珀→橙→红色带而被读成某个负载档。
        v1.19.2 之前这类日子没有独立外观，会被当成「最少」那一档画出来。
    -->
    <SolidColorBrush x:Key="CoreBusyCalendarPendingBrush" Color="#5A4A78" />

    <!--  辉光画刷已废弃：保留资源键置空，避免残留引用解析失败  -->
    <SolidColorBrush x:Key="CoreBusyGlow1Brush" Color="#00000000" />
    <SolidColorBrush x:Key="CoreBusyGlow2Brush" Color="#00000000" />
    <SolidColorBrush x:Key="CoreBusyGlow3Brush" Color="#00000000" />

</ResourceDictionary>
