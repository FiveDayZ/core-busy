<UserControl x:Class="CoreBusy.App.Controls.CpuCoreTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CoreBusy.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="PortraitStyle" TargetType="controls:CoreEvolutionVisual">
            <Setter Property="Height" Value="88" />
            <Setter Property="Margin" Value="0,3,0,2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType={x:Type controls:CpuCoreTile}}}" Value="True">
                    <Setter Property="Height" Value="84" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCondensed, RelativeSource={RelativeSource AncestorType={x:Type controls:CpuCoreTile}}}" Value="True">
                    <Setter Property="Height" Value="{Binding CondensedPortraitHeight, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <!-- 封装占据卡片主体；完整型号与下一形态保留在提示和详情中。 -->
    <Border Background="{Binding TileBackground}" BorderBrush="{StaticResource CoreBusyBorderWeakBrush}"
            BorderThickness="1" CornerRadius="6" Padding="8,5"
            ToolTip="{Binding Level.AppearanceText}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <DockPanel VerticalAlignment="Center">
                    <Ellipse DockPanel.Dock="Left" Width="4" Height="4" Margin="0,0,5,0"
                             Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Id}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource CoreBusyTextSecondaryBrush}" />
                    <TextBlock Text="{Binding Role.Label}" FontSize="10" Margin="5,0,5,0"
                               Foreground="{Binding Role.AccentBrush}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Role.TipText}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" FontSize="10"
                           Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
            </Grid>
            <controls:CoreEvolutionVisual x:Name="Portrait" Style="{StaticResource PortraitStyle}"
                                          Vendor="{Binding Level.Vendor}" Stage="{Binding Level.StageIndex}"
                                          EvolutionVersion="{Binding Level.EvolutionVersion}"
                                          AutomationProperties.Name="{Binding Level.AppearanceText}" />
            <TextBlock Text="{Binding Level.LevelText}" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource CoreBusyAccentBrush}" Typography.NumeralAlignment="Tabular" />
            <controls:SegmentBar x:Name="ExpBar" Height="3" Segments="16" Margin="0,4,0,0"
                                 Value="{Binding Level.ProgressPercent, Mode=OneWay}"
                                 FillBrush="{StaticResource CoreBusyAccentBrush}"
                                 EmptyBrush="{StaticResource CoreBusyTrackBrush}"
                                 ToolTip="{Binding Level.NextEvolutionTip}" />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding UsageText}" ToolTip="{Binding LoadTipText}" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{Binding UsageTextBrush}" Typography.NumeralAlignment="Tabular" />
                <TextBlock Grid.Column="1" Text="{Binding FreqText}" ToolTip="{Binding FrequencySourceText}" FontSize="10" Margin="5,0,0,0"
                           Foreground="{StaticResource CoreBusyTextWeakBrush}" HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Typography.NumeralAlignment="Tabular" />
            </Grid>
            <controls:SegmentBar Height="3" Segments="12" Margin="0,4,0,0"
                                 Visibility="{Binding ShowAggregateBar, Converter={StaticResource BoolToVis}}"
                                 Value="{Binding Usage, Mode=OneWay}" FillBrush="{Binding UsageBrush}"
                                 EmptyBrush="{StaticResource CoreBusyTrackBrush}" />
            <ItemsControl ItemsSource="{Binding Threads}" Margin="0,3,0,0">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="{Binding ShowThreads, Converter={StaticResource BoolToVis}}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCondensed, RelativeSource={RelativeSource AncestorType={x:Type controls:CpuCoreTile}}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,1" ToolTip="{Binding UsageText}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="13" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" FontSize="8" VerticalAlignment="Center"
                                       Foreground="{StaticResource CoreBusyTextWeakBrush}" />
                            <controls:MiniBar Grid.Column="1" Height="3" VerticalAlignment="Center"
                                              Value="{Binding Usage, Mode=OneWay}" FillBrush="{Binding UsageBrush}"
                                              TrackBrush="{StaticResource CoreBusyTrackBrush}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
