<Window x:Class="CoreBusy.App.Views.UpdateProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CORE-BUSY 更新"
        Width="400" Height="158"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CoreBusyBackgroundBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题栏（与设置窗同款）  -->
        <Grid Grid.Row="0" Background="{StaticResource CoreBusyPanelBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <Path Data="{StaticResource IconGear}" Stretch="Uniform" Width="13" Height="13"
                      Fill="{StaticResource CoreBusyAccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="软件更新" FontSize="14" FontWeight="SemiBold" Margin="9,0,0,0"
                           Foreground="{StaticResource CoreBusyTextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <Button Style="{StaticResource CloseButtonStyle}" HorizontalAlignment="Right" Click="OnCancel">
                <Path Data="{StaticResource IconClose}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.4" Stretch="Uniform" Width="11" Height="11" />
            </Button>
        </Grid>

        <!--  进度区：进度条 + 字节计数。数值全部由代码直填（无绑定，规避绑定时序坑）。  -->
        <StackPanel Grid.Row="1" Margin="18,10,18,0">
            <TextBlock x:Name="TitleText" Text="正在下载更新…" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource CoreBusyTextPrimaryBrush}" />
            <ProgressBar x:Name="Bar" Height="8" Minimum="0" Maximum="100" Margin="0,12,0,0"
                         Background="{StaticResource CoreBusyCardBrush}" BorderThickness="0"
                         Foreground="{StaticResource CoreBusyAccentBrush}" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DetailText" Grid.Column="0" Text="准备中…" FontSize="11.5"
                           Foreground="{StaticResource CoreBusyTextWeakBrush}" />
                <TextBlock Grid.Column="1" Text="关闭窗口即取消下载" FontSize="11"
                           Foreground="{StaticResource CoreBusyTextWeakBrush}" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
