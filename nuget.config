<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!--
    这里**不固定** globalPackagesFolder：原先写死的是 C:\Users\Administrator\...（本机根本没有该
    用户目录，裸 dotnet build 会因为建不出目录而失败）。全局包目录改由构建脚本以 NUGET_PACKAGES
    环境变量指定（scripts/build-release.py / .workbuddy/quickbuild.py），默认走
    %USERPROFILE%\.nuget\packages —— 与脚本指向的是同一处。
  -->
</configuration>
