<UserControl x:Class="CoreBusy.App.Controls.RankingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CoreBusy.App.Controls">
    <UserControl.Resources>
        <!--  名次徽章：第 1 名金色高亮，其余低调  -->
        <Style x:Key="RankChip" TargetType="Border">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="{StaticResource CoreBusyTrackBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource PanelCardStyle}" Padding="10,9">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  标题行：图标 + 标题 + TOP5 + 切换 Tab  -->
            <Grid Grid.Row="0" Margin="-2,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="👑" FontFamily="Segoe UI Emoji, Segoe UI" FontSize="13"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SectionTitleText}"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <Border Grid.Column="2" Background="{StaticResource CoreBusyAccentDimBrush}"
                        CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="TOP 5" FontSize="10.5" FontWeight="Bold"
                               Foreground="{StaticResource CoreBusyAccentBrush}" />
                </Border>

                <!--  切换另一个榜单  -->
                <Button Grid.Column="4" Style="{StaticResource ToolButtonStyle}" Padding="9,2.5"
                        Click="OnTabClicked"
                        ToolTip="切换到另一个榜单（分类集合始终固定为 P0-P4）">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="😴" FontFamily="Segoe UI Emoji, Segoe UI" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding TabText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!--  排行行：名次 / 核心 / 占用率 / 进度条  -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          VerticalAlignment="Top">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource RankRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource RankChip}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Rank}" Value="1">
                                                    <Setter Property="Background" Value="{StaticResource CoreBusyYellowBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Rank}" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource CoreBusyTextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Rank}" Value="1">
                                                        <Setter Property="Foreground" Value="#231A0B" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <TextBlock Grid.Column="1" Text="{Binding CoreId}" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource CoreBusyTextPrimaryBrush}"
                                           VerticalAlignment="Center" Margin="6,0,0,0" />

                                <TextBlock Grid.Column="2" Text="{Binding UsageText}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{Binding BarBrush}" VerticalAlignment="Center"
                                           TextAlignment="Right" MinWidth="38" Margin="0,0,10,0" />

                                <controls:MiniBar Grid.Column="3" Height="8" VerticalAlignment="Center"
                                                  Value="{Binding BarValue}" Maximum="100"
                                                  FillBrush="{Binding BarBrush}"
                                                  TrackBrush="{StaticResource CoreBusyTrackBrush}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
