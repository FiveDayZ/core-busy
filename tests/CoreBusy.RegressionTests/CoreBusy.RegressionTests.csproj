    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/CoreBusy.App/CoreBusy.App.csproj" />
    <!-- Window.Icon 使用 application 根 URI，测试宿主也提供同一资源。 -->
