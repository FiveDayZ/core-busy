<Window x:Class="CoreBusy.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CoreBusy.App.Controls"
        Title="CORE-BUSY 核忙 - CPU Core Activity Monitor"
        Icon="pack://application:,,,/Assets/CoreBusy.ico"
        Width="680" Height="500"
        MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource CoreBusyBackgroundBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <!--
      迷你行模板引用了 InverseBoolToVisibility，而它此前只在 CpuCoreTile.xaml 的
      局部资源里定义 —— StaticResource 在模板实例化时才解析，找不到就抛异常。
      异常发生在容器生成的事务里，把本批全部视觉更新（含 7 张卡的移除）一起炸掉，
      又被全局 DispatcherUnhandledException 吞掉 —— 表现为「焦点态零生效、零报错」。
      这是焦点展开悬案的最终根因（UIA 树里迷你行 DataItemControl 的 Name 退化为
      VM 类型全名，即 AutomationProperties.Name 绑定随模板一起未实例化的铁证）。
    -->
    <Window.Resources>
        <controls:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <BooleanToVisibilityConverter x:Key="CoreBusyBoolToVis" />
    </Window.Resources>


    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!--  ==================== 0. 标题栏（同时承担 CPU 身份条）  ====================  -->
        <Grid Grid.Row="0" Background="{StaticResource CoreBusyPanelBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="12,0,0,0">
                <!--  v1.26.4：品牌角标 = 新图标的「Die 2×2 负载格」矢量版。
                      颜色走 DynamicResource 品牌画刷 —— 随 intel/amd 主题联动；
                      四格透明度阶梯 = 负载分档语义（与核卡色阶同构）。  -->
                <Grid Width="22" Height="22" VerticalAlignment="Center">
                    <Border CornerRadius="5" Background="{DynamicResource CoreBusyAccentDimBrush}" />
                    <UniformGrid Columns="2" Rows="2" Margin="4.5">
                        <Border CornerRadius="1.5" Margin="1" Background="{DynamicResource CoreBusyAccentBrush}" Opacity="0.35" />
                        <Border CornerRadius="1.5" Margin="1" Background="{DynamicResource CoreBusyAccentBrush}" Opacity="0.55" />
                        <Border CornerRadius="1.5" Margin="1" Background="{DynamicResource CoreBusyAccentBrush}" Opacity="0.75" />
                        <Border CornerRadius="1.5" Margin="1" Background="{DynamicResource CoreBusyAccentBrush}" />
                    </UniformGrid>
                </Grid>
                <TextBlock Text="CORE-BUSY" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource CoreBusyTextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
                <Border Width="1" Height="12" Background="{StaticResource CoreBusyBorderWeakBrush}"
                        Margin="10,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CpuName}" FontSize="12"
                           Foreground="{StaticResource CoreBusyTextSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding CpuSpecs}" FontSize="11" Margin="8,0,0,0"
                           Foreground="{StaticResource CoreBusyTextWeakBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="PerfModeButton" Click="OnTogglePerformanceMode"
                        ToolTip="性能模式：以低开销档运行（采样降至 2s、暂停硬件传感器），减少对前台程序的干扰">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPerformanceMode}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource CoreBusyAccentDimBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource CoreBusyAccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Data="{StaticResource IconGamepad}" Stretch="Uniform" Width="13" Height="13"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" Fill="{x:Null}"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          VerticalAlignment="Center" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="OnOpenSettings"
                        ToolTip="设置：采样周期 / 硬件传感器 / 主题 / 性能优化">
                    <Path Data="{StaticResource IconGear}" Stretch="Uniform" Width="13" Height="13"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          VerticalAlignment="Center" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Margin="0,0,10,0" Click="OnOpenDataFolder"
                        ToolTip="打开数据文件夹（配置与历史记录）">
                    <Path Data="{StaticResource IconMore}" Stretch="Uniform" Width="13" Height="13"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          VerticalAlignment="Center" />
                </Button>

                <Button Style="{StaticResource CaptionButtonStyle}" Click="OnMinimize">
                    <Path Data="{StaticResource IconMin}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.3" Stretch="Uniform" Width="10" Height="10" />
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Click="OnMaximize">
                    <Path Data="{StaticResource IconMax}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.3" Stretch="Uniform" Width="9" Height="9" />
                </Button>
                <Button Style="{StaticResource CloseButtonStyle}" Click="OnClose">
                    <Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.3" Stretch="Uniform" Width="10" Height="10" />
                </Button>
            </StackPanel>
        </Grid>

        <!--  ==================== 1. 主内容区：PCB 主板（v1.26.0）====================
              背景是静态绘制的 PCB 板（走线/焊盘/安装孔/丝印），
              每颗核心是板上的一颗芯片（见 CpuCoreTile 芯片封装造型）。  -->
        <controls:PcbBoardControl Grid.Row="1" />
        <Grid Grid.Row="1" Margin="10,10,10,8">
            <!--  核心角色卡分区（v1.25.0：养成游戏形态，热力图已随方向调整移除）  -->
            <Grid>
                <!--  1.1 核心分区（动态生成：Intel 混合 → P/E；AMD → CPU Core / CCD n）。
                      芯片直接坐在 PCB 上：仅一层轻微压暗圈出插座区，不再用面板卡片。  -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding CoreGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#17000000" Padding="10,8,10,9" Margin="0,0,0,8"
                                        CornerRadius="8">
                                    <StackPanel>
                                        <controls:SectionHeader Title="{Binding Title}"
                                                                Subtitle="{Binding Subtitle}"
                                                                RightNote="{Binding RightNote}"
                                                                RightNoteVisibility="{Binding RightNoteVisibility}"
                                                                AccentBrush="{StaticResource CoreBusyAccentBrush}">
                                            <controls:SectionHeader.RightContent>
                                                <!--
                                                    负载口径开关（实时 / 累积）。状态是全局唯一的，
                                                    因此只在第一段分区挂出控件（ModeSwitchVisibility 在 VM 内决定），
                                                    Intel 这种 P/E 两段的平台不会出现两个功能重复的开关。
                                                -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding ModeSwitchVisibility}">
                                                    <Border Background="{StaticResource CoreBusyTrackBrush}"
                                                            CornerRadius="5" Padding="1.5">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="实时" Tag="live"
                                                                    Style="{StaticResource LoadModeLiveStyle}"
                                                                    ToolTip="实时负载：每颗核心的瞬时使用率"
                                                                    Click="OnCoreLoadModeClick" />
                                                            <Button Content="累积" Tag="cumulative"
                                                                    Style="{StaticResource LoadModeCumulativeStyle}"
                                                                    ToolTip="累积负载：本次运行时间内的时间加权均值，并按高低排名"
                                                                    Click="OnCoreLoadModeClick" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Button Content="重置" Margin="6,0,0,0"
                                                            Visibility="{Binding ResetVisibility}"
                                                            Style="{StaticResource GhostTextButtonStyle}"
                                                            ToolTip="清零累积统计，从当前时刻重新开始积分"
                                                            Click="OnResetCumulativeClick" />
                                                </StackPanel>
                                            </controls:SectionHeader.RightContent>
                                        </controls:SectionHeader>


                                        <ItemsControl ItemsSource="{Binding Cores}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="{Binding TileColumns}" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!--  点击弹出的卡片承载该核全部深度信息
                                                          （健康度三分量/等级/角色/EXP）——
                                                          主界面保持 8 卡均等的简约布局（v1.23.0 反堆砌）。  -->
                                                    <Border Background="Transparent" Cursor="Hand"
                                                            Tag="{Binding Id}"
                                                            MouseLeftButtonUp="OnCoreTileClick"
                                                            AutomationProperties.Name="{Binding Id}"
                                                            Focusable="True">
                                                        <controls:CpuCoreTile Margin="3,2"
                                                                               IsCompact="{Binding IsCompact}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!--  ==================== 2. 底部状态栏  ====================  -->
        <Border Grid.Row="2" Background="{StaticResource CoreBusyPanelBrush}"
                BorderBrush="{StaticResource CoreBusyBorderWeakBrush}" BorderThickness="0,1,0,0"
                Padding="12,0">
            <controls:StatusBarControl />
        </Border>
    
    <!--  焦点详情弹出卡片（v1.23.0）：点核卡弹出，点卡片外自动关闭。
          AllowsTransparency + 双 Border 模拟软阴影（SoftwareOnly 下
          DropShadowEffect 每帧重渲染是卡顿主因，禁用）。  -->
    <Popup x:Name="FocusCard"
           AllowsTransparency="True"
           StaysOpen="False"
           Placement="Right"
           HorizontalOffset="6" VerticalOffset="-8"
           PopupAnimation="Fade">
        <Border x:Name="FocusCardRoot" Width="248" Background="{StaticResource CoreBusyPanelBrush}"
                BorderBrush="{StaticResource CoreBusyAccentBrush}" BorderThickness="1"
                CornerRadius="8" RenderTransformOrigin="0,0.5">
            <Border Background="Transparent" BorderThickness="0,1,1,1"
                    BorderBrush="#22000000" CornerRadius="8">
                <StackPanel Margin="12,10">
                    <!--  头部：核心号 + 状态 + 健康度  -->
                    <Grid>
                        <TextBlock Text="{Binding Id}" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource CoreBusyTextPrimaryBrush}" />
                        <TextBlock Text="{Binding StatusLabel}" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{Binding StatusBrush}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <!--  使用率大字 + 负载条  -->
                    <Grid Margin="0,6,0,0">
                        <TextBlock Text="{Binding UsageText}" FontSize="26" FontWeight="Bold"
                                   Foreground="{Binding UsageTextBrush}"
                                   Typography.NumeralAlignment="Tabular" />
                    </Grid>
                    <controls:MiniBar Height="5" Margin="0,4,0,0"
                                      Value="{Binding Usage, Mode=OneWay}"
                                      FillBrush="{Binding UsageBrush}"
                                      TrackBrush="{StaticResource CoreBusyTrackBrush}" />
                    <TextBlock Text="{Binding FreqText}" FontSize="10"
                               Foreground="{StaticResource CoreBusyTextWeakBrush}" Margin="0,4,0,0"
                               Typography.NumeralAlignment="Tabular" />

                    <!--  成长主体（v1.27.0）：大号等级 + 平滑生长的 EXP 动画条 + ETA 预估。
                          文字解释（口径声明/解锁清单）全部撤下：口径细节收进进度条 ToolTip，
                          升级预告压缩为一行 ETA —— 看一眼就知道"在涨、涨多快、还差多少"。  -->
                    <Separator Margin="0,8,0,6" Background="{StaticResource CoreBusyTrackBrush}" />
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Level.LevelText}" FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource CoreBusyAccentBrush}"
                                       Typography.NumeralAlignment="Tabular" />
                            <StackPanel Margin="10,0,0,3" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding Level.StageText}" FontSize="11"
                                           Foreground="{StaticResource CoreBusyTextSecondaryBrush}" />
                                <TextBlock Text="{Binding Role.Label}" FontSize="10" Margin="0,1,0,0"
                                           Foreground="{Binding Role.AccentBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding Level.EtaText}" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource CoreBusyAccentBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>

                    <!--  EXP 动画条：宽度由 code-behind 在每次 Progress 变化时补间（ease-out），
                          打开弹卡时从 0 生长到当前值 —— 直观呈现"这条就是攒下的经验"。
                          完整口径说明收进 ToolTip（默认不可见，零视觉噪音）。  -->
                    <Border x:Name="ExpTrack" Height="9" Margin="0,9,0,0"
                            Background="{StaticResource CoreBusyTrackBrush}" CornerRadius="4.5"
                            ToolTip="{Binding Level.TipText}" ToolTipService.ShowDuration="20000">
                        <Border x:Name="ExpFill" HorizontalAlignment="Left" CornerRadius="4.5" Width="0"
                                Background="{StaticResource CoreBusyAccentBrush}" />
                    </Border>

                    <TextBlock Text="{Binding Level.NextUnlockText}" FontSize="9" Margin="0,5,0,0"
                               Foreground="{StaticResource CoreBusyTextWeakBrush}" />
                </StackPanel>
            </Border>
        </Border>
    </Popup>
</Grid>

</Window>
