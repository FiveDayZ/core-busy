<Window x:Class="CoreBusy.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CORE-BUSY 设置"
        Icon="pack://application:,,,/Assets/CoreBusy.ico"
        Width="700" Height="690"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CoreBusyBackgroundBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!--  选项标题 / 说明  -->
        <Style x:Key="OptionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource CoreBusyTextPrimaryBrush}" />
        </Style>
        <Style x:Key="OptionHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource CoreBusyTextWeakBrush}" />
        </Style>

        <!--  左侧分类导航项  -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource CoreBusyTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" CornerRadius="6" Padding="12,9"
                                Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource CoreBusyCardBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource CoreBusyAccentDimBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource CoreBusyAccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  分段选项（采样周期 / 主题 / 核心分区 / 电源预设）  -->
        <Style x:Key="SegmentRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource CoreBusyTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" CornerRadius="6" Padding="12,7"
                                Background="{StaticResource CoreBusyCardBrush}"
                                BorderBrush="{StaticResource CoreBusyBorderWeakBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource CoreBusyBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource CoreBusyAccentDimBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource CoreBusyAccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource CoreBusyAccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  勾选项  -->
        <Style x:Key="OptionCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource CoreBusyTextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                    Background="{StaticResource CoreBusyCardBrush}"
                                    BorderBrush="{StaticResource CoreBusyBorderBrush}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Tick" Data="M 0,3.4 L 3.2,6.6 L 9.2,0.6"
                                      Stroke="White" StrokeThickness="1.8" Stretch="None"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource CoreBusyAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource CoreBusyAccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource CoreBusyAccentBrush}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  行内小勾选（进程规则行内使用，字号与间距收紧）  -->
        <Style x:Key="MiniCheck" TargetType="CheckBox" BasedOn="{StaticResource OptionCheck}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource CoreBusyTextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>

        <!--  深色下拉框。必须整体改模板：WPF 默认 ComboBox 的下拉浮层背景来自
             SystemColors.WindowBrush（白色），与本窗口的浅色文字叠加后完全不可读。  -->
        <Style x:Key="OptionCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource CoreBusyTextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource CoreBusyTextPrimaryBrush}" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Padding" Value="9,6" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Root" Background="Transparent" CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{StaticResource CoreBusyHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource CoreBusyAccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" CornerRadius="6"
                                                Background="{StaticResource CoreBusyCardBrush}"
                                                BorderBrush="{StaticResource CoreBusyBorderWeakBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="22" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="9,0,0,0"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <Path Grid.Column="1" Data="M 0,0 L 4,4 L 8,0"
                                                      Stroke="{StaticResource CoreBusyTextWeakBrush}" StrokeThickness="1.3"
                                                      Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource CoreBusyBorderBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{StaticResource CoreBusyPanelBrush}"
                                        BorderBrush="{StaticResource CoreBusyBorderBrush}" BorderThickness="1"
                                        CornerRadius="6" Margin="0,2,0,0" Padding="3"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        MaxHeight="220">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  紧凑文本按钮（添加 / 还原 / 删除）  -->
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource CoreBusyAccentBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="{StaticResource CoreBusyAccentDimBrush}"
                                BorderBrush="{StaticResource CoreBusyBorderWeakBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource CoreBusyAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  主按钮（确定）  -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="24,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="{StaticResource CoreBusyAccentBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.86" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  次按钮（取消）  -->
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="{StaticResource CoreBusyTextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="{StaticResource CoreBusyCardBrush}"
                                BorderBrush="{StaticResource CoreBusyBorderWeakBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource CoreBusyBorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource CoreBusyTextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  BooleanToVisibilityConverter 必须在 RuleRowTemplate **之前**声明：
              StaticResource 不允许前向引用，放后面会让规则行模板每次实例化都抛
              XamlParseException（v1.15.0 实测单会话刷屏数千条，规则行渲染残缺）。 -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--  进程规则行模板  -->
        <DataTemplate x:Key="RuleRowTemplate">
            <Border CornerRadius="8" Padding="10,8" Margin="0,0,0,6"
                    Background="{StaticResource CoreBusyCardBrush}"
                    BorderBrush="{StaticResource CoreBusyBorderWeakBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Style="{StaticResource MiniCheck}" Margin="0,0,10,0"
                                  IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ProcessName}" FontSize="12.5"
                                   FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource CoreBusyTextPrimaryBrush}" />
                        <Button Grid.Column="2" Content="删除" Style="{StaticResource MiniButton}"
                                Tag="{Binding}" Click="OnRemoveRule" />
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="亲和性" FontSize="11.5" VerticalAlignment="Center"
                                   Margin="0,0,8,0" Foreground="{StaticResource CoreBusyTextWeakBrush}" />
                        <ComboBox Grid.Column="1" Style="{StaticResource OptionCombo}"
                                  ItemsSource="{Binding AffinityOptions}"
                                  SelectedIndex="{Binding AffinityIndex, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="优先级" FontSize="11.5" VerticalAlignment="Center"
                                   Margin="12,0,8,0" Foreground="{StaticResource CoreBusyTextWeakBrush}" />
                        <ComboBox Grid.Column="3" Style="{StaticResource OptionCombo}"
                                  ItemsSource="{Binding PriorityOptions}"
                                  SelectedIndex="{Binding PriorityIndex, Mode=TwoWay}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                Visibility="{Binding IsCustomAffinity, Converter={StaticResource BoolToVis}}">
                        <Button Content="选择核心…" Style="{StaticResource MiniButton}"
                                Tag="{Binding}" Click="OnPickCores" />
                        <TextBlock Text="{Binding AffinitySummary}" FontSize="11.5" Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource CoreBusyTextWeakBrush}" />
                        <TextBlock Text="掩码第 n 位对应逻辑处理器 n，至少保留 1 个。" FontSize="11"
                                   Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource CoreBusyTextWeakBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox Style="{StaticResource MiniCheck}" Content="内核强制亲和"
                                  IsChecked="{Binding KernelEnforced, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource MiniCheck}" Content="磁盘 I/O 降至最低"
                                  IsChecked="{Binding LowerIoPriority, Mode=TwoWay}" />
                        <CheckBox Style="{StaticResource MiniCheck}" Content="仅游戏时生效"
                                  ToolTip="勾选后该规则只在检测到全屏游戏时套用，退出游戏即恢复默认优先级，日常使用不受影响。需要「常规」页的「启用游戏模式」同时打开。"
                                  IsChecked="{Binding GameOnly, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题栏  -->
        <Grid Grid.Row="0" Background="{StaticResource CoreBusyPanelBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <Path Data="{StaticResource IconGear}" Stretch="Uniform" Width="13" Height="13"
                      Fill="{StaticResource CoreBusyAccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="设置" FontSize="14" FontWeight="SemiBold" Margin="9,0,0,0"
                           Foreground="{StaticResource CoreBusyTextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <Button Style="{StaticResource CloseButtonStyle}" HorizontalAlignment="Right" Click="OnCancel">
                <Path Data="{StaticResource IconClose}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.4" Stretch="Uniform" Width="11" Height="11" />
            </Button>
        </Grid>

        <!--  主体：左侧分类导航 + 右侧内容  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="148" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource CoreBusyPanelBrush}" Padding="10,14">
                <StackPanel>
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="常规" IsChecked="True" Checked="OnNavChanged" />
                    <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="外观" Checked="OnNavChanged" />
                    <RadioButton x:Name="NavOptimize" Style="{StaticResource NavItem}" GroupName="Nav"
                                 Content="性能优化" Checked="OnNavChanged" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="18,14,14,0">
                <!--  ===== 常规 =====  -->
                <ScrollViewer x:Name="PaneGeneral" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="采样周期" Style="{StaticResource OptionLabel}" />
                        <TextBlock Text="周期越短数据越实时，本工具自身开销也略高。" Style="{StaticResource OptionHint}" Margin="0,3,0,9" />
                        <UniformGrid Columns="3">
                            <RadioButton x:Name="IntervalFast" Style="{StaticResource SegmentRadio}" GroupName="Interval"
                                         Content="500 毫秒 · 高刷新" Margin="0,0,6,0" />
                            <RadioButton x:Name="IntervalNormal" Style="{StaticResource SegmentRadio}" GroupName="Interval"
                                         Content="1000 毫秒 · 默认" Margin="0,0,6,0" />
                            <RadioButton x:Name="IntervalSlow" Style="{StaticResource SegmentRadio}" GroupName="Interval"
                                         Content="2000 毫秒 · 低开销" />
                        </UniformGrid>

                        <Border Height="1" Background="{StaticResource CoreBusyBorderWeakBrush}" Margin="0,16,0,14" />

                        <CheckBox x:Name="SensorsCheck" Style="{StaticResource OptionCheck}"
                                  Content="启用硬件传感器（温度 / 功耗 / 频率 / 风扇）" />
                        <TextBlock Text="传感器读取需以管理员身份运行；关闭后本工具占用更低，温度 / 功耗 / 风扇显示为 —。"
                                   Style="{StaticResource OptionHint}" Margin="25,5,0,0" />

                        <CheckBox x:Name="GameCheck" Style="{StaticResource OptionCheck}" Margin="0,14,0,0"
                                  Content="启用游戏模式（全屏 / 无边框全屏检测）" />
                        <TextBlock Text="游戏模式下「性能优化」页的联动预设才会生效。"
                                   Style="{StaticResource OptionHint}" Margin="25,5,0,0" />

                        <CheckBox x:Name="CloseToTrayCheck" Style="{StaticResource OptionCheck}" Margin="0,14,0,0"
                                  Content="关闭窗口时最小化到托盘（通知区域）" />
                        <TextBlock Text="勾选后点击关闭仅隐藏窗口，托盘图标双击恢复显示、右键退出；不勾选则直接退出。"
                                   Style="{StaticResource OptionHint}" Margin="25,5,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <!--  ===== 外观 =====  -->
                <ScrollViewer x:Name="PaneAppearance" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="主题" Style="{StaticResource OptionLabel}" />
                        <TextBlock Text="自动跟随 CPU 厂商；也可手动锁定（规范 §7）。" Style="{StaticResource OptionHint}" Margin="0,3,0,9" />
                        <UniformGrid Columns="3">
                            <RadioButton x:Name="ThemeAuto" Style="{StaticResource SegmentRadio}" GroupName="Theme"
                                         Content="自动" Margin="0,0,6,0" />
                            <RadioButton x:Name="ThemeIntel" Style="{StaticResource SegmentRadio}" GroupName="Theme"
                                         Content="Intel Blue" Margin="0,0,6,0" />
                            <RadioButton x:Name="ThemeAmd" Style="{StaticResource SegmentRadio}" GroupName="Theme"
                                         Content="AMD Red" />
                        </UniformGrid>

                        <Border Height="1" Background="{StaticResource CoreBusyBorderWeakBrush}" Margin="0,16,0,14" />

                        <TextBlock Text="核心分区" Style="{StaticResource OptionLabel}" />
                        <TextBlock Text="规范：Intel 混合显 P/E，AMD 显 CPU Core / CCD（不出现 P-Core / E-Core）。设计稿：两段 P/E 写法。"
                                   Style="{StaticResource OptionHint}" Margin="0,3,0,9" />
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="LayoutSpec" Style="{StaticResource SegmentRadio}" GroupName="Layout"
                                         Content="规范（CPU Core / CCD）" Margin="0,0,6,0" />
                            <RadioButton x:Name="LayoutDraft" Style="{StaticResource SegmentRadio}" GroupName="Layout"
                                         Content="设计稿（P / E 两段）" />
                        </UniformGrid>

                        <TextBlock Text="主题与核心分区在窗口构建前生效，修改后需重启应用。"
                                   Style="{StaticResource OptionHint}" Margin="0,14,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <!--  ===== 性能优化 =====  -->
                <ScrollViewer x:Name="PaneOptimize" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,4,0">
                        <CheckBox x:Name="OptimizeCheck" Style="{StaticResource OptionCheck}"
                                  Content="启用 CPU 核心优化" />
                        <TextBlock x:Name="OptimizeStatusText" Style="{StaticResource OptionHint}" Margin="25,5,0,0"
                                   Text="正在读取硬件能力…" />

                        <Border Height="1" Background="{StaticResource CoreBusyBorderWeakBrush}" Margin="0,16,0,14" />

                        <TextBlock Text="电源策略" Style="{StaticResource OptionLabel}" />
                        <TextBlock Text="改动当前电源方案中的核心停放 / 能源性能偏好 / 处理器最大状态。首次应用前会自动备份原始值，可随时还原。插电与电池两套值会同时写入。"
                                   Style="{StaticResource OptionHint}" Margin="0,3,0,9" />
                        <UniformGrid Columns="3">
                            <RadioButton x:Name="PowerNone" Style="{StaticResource SegmentRadio}" GroupName="Power"
                                         Content="不干预" Margin="0,0,6,0" IsChecked="True" />
                            <RadioButton x:Name="PowerPerformance" Style="{StaticResource SegmentRadio}" GroupName="Power"
                                         Content="性能优先" Margin="0,0,6,0" />
                            <RadioButton x:Name="PowerSaver" Style="{StaticResource SegmentRadio}" GroupName="Power"
                                         Content="节能优先" />
                        </UniformGrid>
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PowerStatusText" Grid.Column="0" Style="{StaticResource OptionHint}"
                                       VerticalAlignment="Center" Text="正在读取电源方案…" />
                            <Button x:Name="PowerRestoreButton" Grid.Column="1" Content="还原原始值"
                                    Style="{StaticResource MiniButton}" Click="OnRestorePower" />
                        </Grid>
                        <TextBlock Text="「性能优先」会解除核心停放并把 EPP 拉到满性能，代价是待机功耗与温度上升（约 +10~30W / +5~10℃）；笔记本电池模式下请谨慎。"
                                   Style="{StaticResource OptionHint}" Margin="0,8,0,0" />

                        <Border Height="1" Background="{StaticResource CoreBusyBorderWeakBrush}" Margin="0,16,0,14" />

                        <TextBlock Text="进程规则" Style="{StaticResource OptionLabel}" />
                        <TextBlock Text="按进程名套用核心亲和性与优先级，同名新启动的进程会自动接管。系统关键进程（csrss / lsass / svchost 等）一律拒绝，避免整机假死。"
                                   Style="{StaticResource OptionHint}" Margin="0,3,0,9" />

                        <Border CornerRadius="8" Padding="11,10" Margin="0,0,0,10"
                                Background="{StaticResource CoreBusyCardBrush}"
                                BorderBrush="{StaticResource CoreBusyBorderWeakBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="一键降级后台负载" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource CoreBusyTextPrimaryBrush}" />
                                <TextBlock Text="把常见的后台重负载整体降到「低于标准」优先级，并把磁盘 I/O 压到最低。这是本页最有效的用法 —— 提升来自「压制抢资源的进程」，而不是给前台应用提权。"
                                           Style="{StaticResource OptionHint}" Margin="0,4,0,8" />
                                <ItemsControl x:Name="PresetList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource MiniCheck}" Margin="0,0,10,7"
                                                      Content="{Binding Title}"
                                                      ToolTip="{Binding Hint}"
                                                      IsChecked="{Binding Selected, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PresetStatusText" Grid.Column="0" Style="{StaticResource OptionHint}"
                                               VerticalAlignment="Center" Margin="0,0,10,0"
                                               Text="勾选类别后点右侧按钮；生成的规则会进入下方列表，可逐条删改。" />
                                    <Button Grid.Column="1" Content="添加选中类别" Style="{StaticResource MiniButton}"
                                            Click="OnAddPresets" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ProcessPicker" Grid.Column="0" Style="{StaticResource OptionCombo}" />
                            <Button Grid.Column="1" Content="添加规则" Style="{StaticResource MiniButton}"
                                    Margin="8,0,0,0" Click="OnAddRule" />
                        </Grid>

                        <ItemsControl x:Name="RulesList" ItemTemplate="{StaticResource RuleRowTemplate}" />
                        <TextBlock x:Name="RulesEmptyText" Style="{StaticResource OptionHint}" Margin="2,4,0,0"
                                   Text="尚未添加规则。可从上方的类别一键添加，或选一个正在运行的进程逐条添加。" />

                        <Border Height="1" Background="{StaticResource CoreBusyBorderWeakBrush}" Margin="0,16,0,14" />

                        <TextBlock Text="游戏模式联动" Style="{StaticResource OptionLabel}" />
                        <CheckBox x:Name="GameOptimizeCheck" Style="{StaticResource OptionCheck}" Margin="0,8,0,0"
                                  Content="进入全屏游戏时自动套用下面的预设" />
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="亲和性" FontSize="11.5" VerticalAlignment="Center"
                                       Margin="0,0,8,0" Foreground="{StaticResource CoreBusyTextWeakBrush}" />
                            <ComboBox x:Name="GameAffinityCombo" Grid.Column="1" Style="{StaticResource OptionCombo}"
                                      SelectionChanged="OnGameAffinityChanged" />
                            <TextBlock Grid.Column="2" Text="优先级" FontSize="11.5" VerticalAlignment="Center"
                                       Margin="12,0,8,0" Foreground="{StaticResource CoreBusyTextWeakBrush}" />
                            <ComboBox x:Name="GamePriorityCombo" Grid.Column="3" Style="{StaticResource OptionCombo}" />
                        </Grid>

                        <StackPanel x:Name="GameCustomPanel" Orientation="Horizontal" Margin="0,8,0,0"
                                    Visibility="Collapsed">
                            <Button Content="选择核心…" Style="{StaticResource MiniButton}"
                                    Click="OnPickGameCores" />
                            <TextBlock x:Name="GameCustomSummary" FontSize="11.5" Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource CoreBusyTextWeakBrush}" />
                        </StackPanel>
                        <CheckBox x:Name="GamePowerCheck" Style="{StaticResource OptionCheck}" Margin="0,12,0,0"
                                  Content="同时应用「性能优先」电源策略（退出游戏后自动还原）" />
                        <TextBlock Text="规则与游戏模式都需要上方总开关处于启用状态。勾了「仅游戏时生效」的规则还依赖「常规」页的「启用游戏模式」，否则不会被套用。"
                                   Style="{StaticResource OptionHint}" Margin="0,10,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!--  操作区  -->
        <Border Grid.Row="2" Background="{StaticResource CoreBusyPanelBrush}"
                Padding="18,12" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource GhostButton}" Click="OnCancel" IsCancel="True" />
                <Button Content="确定" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                        Click="OnOk" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
